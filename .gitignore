# deps / build
node_modules/
dist/
build/
__pycache__/
*.pyc
.venv/
venv/
.env
.env.*
/target

# databases / runtime state (NEVER commit live data or lock files)
*.db
*.sqlite
*.sqlite3
# redb cache files (scan-engine writes *.redb to temp/state dirs)
*.redb
# SQLite / redb transaction journals
*-shm
*-wal
*-journal

# pipeline / test artifacts
/tmp/
test-results.json
*.log
coverage/
playwright-report/
test-results/

# local working notes (never commit)
UI_BACKLOG.md
CODEBASE_REVIEW.md

# screenshots that are QA artifacts (uncomment to exclude debug shots; keep if you
# want them in the repo as documentation)
# screenshots/

# OS / editor
.DS_Store
.idea/
.vscode/
